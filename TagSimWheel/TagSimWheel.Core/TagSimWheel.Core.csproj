<Project Sdk="Microsoft.NET.Sdk">

  <!-- netstandard2.0 so the same DLL can be referenced from a WinForms app (.NET 8)
       and later dropped into a Unity project (TagSim3D) unchanged. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>TagSimWheel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpDX.DirectInput" Version="4.2.0" />
  </ItemGroup>

</Project>
